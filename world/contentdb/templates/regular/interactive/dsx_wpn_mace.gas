[t:template,n:dsx_base_mace]
{
	doc = "Mace";
	specializes = base_mace;
	[aspect]
	{
		material = steelblunt;
		[voice]
		{
			[put_down]
			{
				* = s_e_gui_put_down_mace;
			}
		}
	}
	[attack]
	{
		attack_class = ac_mace;
		is_melee = true;
		reload_delay = 0;
		skill_class = melee;
	}
	[gui]
	{
		active_icon = b_gui_ig_i_ic_mce_001;
		equip_slot = es_weapon_hand;
	}
}
