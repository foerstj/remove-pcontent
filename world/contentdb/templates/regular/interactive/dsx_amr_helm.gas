[t:template,n:dsx_base_helm]
{
	doc = "DSX helm base template";
	specializes = base_helm;
	[aspect]
	{
		[voice]
		{
			[put_down]
			{
				* = s_e_gui_put_down_helmet;
			}
		}
	}
	[gui]
	{
		equip_slot = es_head;
		inventory_height = 2;
		inventory_width = 2;
	}
}
