				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
			}
			[*]
			{
				alteration = alter_mana_steal;
				value = 10;
				description = "";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
