	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_piercing_damage_chance_ranged;
				value = 50;
				description = "+50% Chance to Inflict a Piercing Hit";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
			}
			[*]
			{
				alteration = alter_piercing_damage_chance_melee;
				value = 50;
				description = "";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
			}
