	//// START PREFIXES ////
	//--FEAR / BLUSTERING PREFIX
	[blustering]
	{
		object_types = melee;
		screen_name = "Blustering";
		type = prefix;
		power = 5;

		[custom_chance]
		{
			description = "+10% Chance To Flee And";
			alteration = alter_custom_damage_chance_melee;
			custom_damage = flee;
			value = 10;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
		}
		[custom_damage]
		{
			description = " Adds 10 to 20 Fear Damage";
			alteration = alter_custom_damage_melee;
			max_value = 20;
			value = 10;
			custom_damage = flee;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
			custom_damage_skrit = world\global\skrits\weapon_flee.skrit;
			effect_script_equip = dsx_modifier_blustering_melee;
			effect_script_hit = dsx_modifier_blustering_hit;
		}
	}

	[bullying]
	{
		screen_name = "Bullying";
