		[*]
		{
			state_name = Charge;
			state_desc = "Charged";
			is_imbued = true;
			description = "Raises the Max Melee damage of the character by <alter_melee_damage_max>.";
			alteration = alter_melee_damage_max;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
			min_level = 1;
			max_level = 15;
			value = 1.1+(#uberlevel*.6);
			//			value = ((#uberlevel+1)*4.2-.7);
			effect_script_equip = charged_fist;
		}
	}

	[ofogresmight]
	{
		special_type	= rare;
		type = suffix;
