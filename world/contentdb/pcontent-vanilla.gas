//////////////////////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////////////////////

[formulas]
{
	// these blocks define the "infinite power" weapons - these will always be
	// able to go up to any power level by feedback into the modifiers.

	[infinite_melee_weapons]
	{
		* = sword;
		* = axe;
		* = staff;
	}

	[infinite_ranged_weapons]
	{
		* = bow;
	}
}

//////////////////////////////////////////////////////////////////////////////

[macros]
{
	supersword = sword/500;
}

//////////////////////////////////////////////////////////////////////////////

[modifiers]
{
	//////////////////////////////////////////////////////////
	// END DS1 Modifiers

	//// IMBUED ITEMS ////

	[ofmagicarmor]
	{
		special_type	= rare;
		type = suffix;
		object_types = armor;
		screen_name = "Of Magic Armor";
		power = 1;

		tooltip_weight  = 2;
		tooltip_color   = "imbued";

		[*]
		{
			state_name = armor;
			state_desc = "Armored";
			is_imbued = true;
			description = "Surrounds the character with a shell of magical energy, adding <alter_armor> to Armor.";
			alteration = alter_armor;
			//			value = 1.3 + (#uberlevel*0.7);
			value = 1.3 + (#uberlevel*0.7);
			max_level = 15;
			min_level = 1;
			//			min_level = 3;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
			effect_script_equip = magic_armor;
		}
	}

	[ofspiritarmor]
	{
		special_type	= rare;
		type = suffix;
		object_types = armor;
		screen_name = "Of Spirit Armor";
		power = 6;

		tooltip_weight  = 2;
		tooltip_color   = "imbued";

		[*]
		{
			state_name = armor;
			state_desc = "Armored";
			is_imbued = true;
			description = "Adds <alter_armor> to armor.";
			alteration = alter_armor;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
			//			min_level = 25;
			min_level = 1;
			max_level = 45;
			value = 1.3 + ( #uberlevel * 0.7 ); 
			effect_script_equip = spirit_armor;
		}
	}

	[ofpersonalstoneskin]
	{
		special_type	= rare;
		type = suffix;
		object_types = armor;
		screen_name = "Of Personal Stone Skin";
		power = 12;

		tooltip_weight  = 2;
		tooltip_color   = "imbued";

		[*]
		{
			state_name = armor;
			state_desc = "Armored";
			is_imbued = true;
			description = "Surrounds the character with a shell of magical energy, adding <alter_armor> to Armor.";
			alteration = alter_armor;
			max_level = 120;
			min_level = 1;
			//			min_level = 28;
			//			value = ((#uberlevel-26)*0.6)+11.6;
			value = 1.3 + ( #uberlevel * 0.7 ); 
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
			effect_script_equip = magic_armor;
		}
	}

	[oflifeforce]
	{
		special_type	= rare;
		type = suffix;
		object_types = weapon;
		screen_name = "Of Life Force";
		power = 2;

		tooltip_weight  = 2;
		tooltip_color   = "imbued";

		[*]
		{
			state_name = Lifeforce;
			state_desc = "Lifeforce";
			is_imbued = true;
			description = "Increases wielders melee damage versus Undead by +<alter_damage_bonus_to_undead> points.";
			alteration = alter_damage_bonus_to_undead;

			value = 1.4+(#uberlevel*.6);

			max_level = 39;
			min_level = 1;
			//			min_level = 14;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
			effect_script_equip = lifeforce;
			effect_script_hit = hit_spark_10_lre;
		}
	}

	[ofpersonalmysticaid]
	{
		special_type	= rare;
		type = suffix;
		object_types = armor,ring,amulet;
		screen_name = "Of Personal Mystic Aid";
		power = 6;

		tooltip_weight  = 2;
		tooltip_color   = "imbued";

		[*]
		{
			state_name = boosts;
			state_desc = "Mystic Aid";
			is_imbued = true;
			description = "Raises the character's chance to hit in Melee combat by <alter_chance_to_hit_melee>% and";
			alteration = alter_chance_to_hit_melee;
			//strictly better than the original mystic aid, but necessary for the low level
			value = (#uberlevel*0.1157)+1; //-4;
			min_level = 1;
			//			min_level = 84;
			max_level = 108;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
		}
		[*]
		{
			state_name = boosts;
			state_desc = "Mystic Aid";
			is_imbued = true;
			description = " chance to hit in Ranged Combat by <alter_chance_to_hit_ranged>%.";
			alteration = alter_chance_to_hit_ranged;
			value = (#uberlevel*0.1157)+1; //see above
			min_level = 1;
			//			min_level = 84;
			max_level = 104;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
			effect_script_equip = stats_boost;
		}
	}

	[ofchargedfist]
	{
		special_type	= rare;
		type = suffix;
		object_types = gloves;
		screen_name = "Of Charged Fist";
		power = 1;

		tooltip_weight  = 2;
