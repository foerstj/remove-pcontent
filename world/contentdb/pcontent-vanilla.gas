			alteration			= alter_melee_damage_min;
			value				= 2;
			duration			= #infinite;
			is_permanent		= true;
			is_single_instance	= false;
			effect_script_equip	= dsx_modifier_massive_melee;
			effect_script_hit	= dsx_modifier_massive_hit;
		}
		[damage_max]
		{
			alteration			= alter_melee_damage_max;
			value				= 3;
			description			= "Adds 2 to 3 Melee Damage";
			duration			= #infinite;
			is_permanent		= true;
			is_single_instance	= false;
		}
		[melee]
		{
			description = "Adds 1 to Melee Skill";
			alteration = alter_melee;
			value = 1;
			duration = #infinite;
			is_permanent = true;
			is_single_instance = false;
		}
	}

